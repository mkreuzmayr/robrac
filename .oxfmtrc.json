{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "tabWidth": 2,
  "arrowParens": "always",
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortImports": true,
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"]
}
